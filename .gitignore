# 依赖
node_modules/

# 运行时日志
logs/
*.tmp

# 本地私有配置（含 token，勿提交）
config.json
config.json.broken-*
server/game-processes.json

# 运行时缓存（程序图标等，可重新生成）
cache/

# 预览截图（由 scripts/shoot.js 生成，可重新生成）
preview/

# 调试遗留物
_hero_probe.jpg
_probe_*.png
boot.out.txt
boot.err.txt

# 原始设计稿（体积大，不随代码发布）
evaming-ri-xiang-dian-nao-jian-kong-mian-ban.html

# 发布包
*.zip

# 桌面打包产物（build staging / dist exe / PyInstaller 中间件）
build/
dist/
packaging/*.spec
__pycache__/
*.pyc

# 权限诊断脚本产生的临时备份与报告
.acl-diagnose/
acl-report/

# 本地验收脚本生成的机器相关结果
scripts/*.result.json

# 运行时用户数据（上传的主视觉图等，由面板自行生成）
data/
